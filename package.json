{
  "name": "hare",
  "version": "1.10.0",
  "description": "Control the speed of any video or audio, with keyboard shortcuts and two-tab sync",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "vitest",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build",
    "type-check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "test:unit": "vitest run",
    "check": "npm run type-check && npm run test:unit && npm run build && npm run build:firefox"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
